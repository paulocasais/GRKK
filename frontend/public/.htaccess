RewriteEngine On

# Mapeamento de payloads Next.js RSC (correção do bug de exportação estática com App Router)
# Exemplo: /exames/__next.!KGRhc2hib2FyZCk.exames.__PAGE__.txt -> /exames/__next.!KGRhc2hib2FyZCk/exames/__PAGE__.txt
RewriteCond %{REQUEST_URI} ^/(.+)/__next\.!([^.]+)\.([^.]+)\.__PAGE__\.txt$
RewriteRule ^.*$ /%1/__next.!%2/%3/__PAGE__.txt [L]

# Exemplo: /exames/__next.!KGRhc2hib2FyZCk.exames.txt -> /exames/__next.!KGRhc2hib2FyZCk/exames.txt
RewriteCond %{REQUEST_URI} ^/(.+)/__next\.!([^.]+)\.([^.]+)\.txt$
RewriteRule ^.*$ /%1/__next.!%2/%3.txt [L]

# Roteamento padrão de arquivos estáticos HTML (.html opcional na URL)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Configuração de Cache-Control para evitar cache do HTML (previne carregar CSS/JS antigos de builds anteriores)
<IfModule mod_headers.c>
    # Não cachear arquivos HTML (garante carregar sempre o HTML novo)
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Cache longo para arquivos com hash de build (_next/static)
    <FilesMatch "\.(css|js|woff2|png|jpg|jpeg|svg|ico)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>
</IfModule>
